#!/bin/sh
#
# HAVE: optenv
# NEED: ${B}/MY/option.mk
#
set -e
Bdir=${1?usage: $0 Bdir}
shift
[ "$#" -ge 1 ] || { echo >&2 "E: missing argv[0]"; exit 1; }
while read -r line
do
	if expr "${line}" : '^#' >/dev/null
	then
		continue
	fi
	val=${line#*=}
	key=${line%%=*}
# Translate base_url to BASE_URL
	KEY=$(printf '%s' "$key" | tr a-z A-Z)
	qal="'$(printf '%s' "$val" | sed "
		s/^[[:blank:]]*// ;
		s/[[:blank:]]*$// ;
		s/'/\\'/g")'"
	eval "export $KEY=$qal"
done <"$Bdir"/MY/option.mk
exec "$@"
