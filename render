#!/usr/bin/env perl

use strict;
use warnings;
use Template;
use File::Spec::Unix;
use v5.10;

sub or_else_factory {
	my ($ctx, $default) = @_;
	return sub {
		my $text = shift;
		return length $text || !(defined $default) ? $text : $default;
	}
}

sub to_root {
	my ($ctx, $root) = @_;
	$root //= "/";
	return sub {
		my $path = shift;
		die "bad URL location: $path\n" unless substr ($path, 0, 1) eq "/";
		my ($volume, $directory, $file) = File::Spec::Unix->splitpath ($path);
		my $relative = File::Spec::Unix->abs2rel ($root, $directory);
		if (substr ($relative, 0, 1) eq "/") {
			die "abs2rel computed ('$root', '$directory') with an "
			. "absolute path ('$relative')\n";
		}
		return $relative . "/";
	}
}

my $file = shift;
die "usage: $0 <file>\n" unless defined $file;

my $template = Template->new({
	INCLUDE_PATH => ['site', 'temple'],
	FILTERS => {
		or_else => [ \&or_else_factory, 1 ],
		to_root => [ \&to_root, 1 ],
	},
}) || die $Template::ERROR, "\n";

$template->process($file, {
	BASE_URL => $ENV{BASE_URL} // 'https://rapidcow.neocities.org'
}) || die $template->error(), "\n";
