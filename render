#!/usr/bin/env perl

use 5.010;
use strict;
use warnings;
use Template;
use File::Spec;
use Getopt::Std;
use RdKw::WwW::GenGenLib qw(read_deps load_state);
use RdKw::WwW::GenLib qw(relapath);
use Digest::SHA;
use Site::Deps qw(norm_path walk_deps);
use Site::TemplateProvider;
# handy guys for templating
use HTML::Tiny;
use Time::Piece;

use File::Which;
use RdKw::IPC::Unix;

my %o;
getopts('B:b:', \%o) && @ARGV == 1
	or die "usage: $0 [-B BUILDDIR] [-b OUTPUTDIR] -- <file>\n";
my $B = $o{B} // '.';
my $b = $o{b} // 'public';
my ($file) = @ARGV;

my $git_bin = which("git");
$git_bin or die "error: git not found\n";
my $Git = RdKw::IPC::Unix->new( "git" )->file( $git_bin )
	->setenv( TERM => 'dumb' );

sub pipe_head {
	$_[0]->dup(">|", my $pipi)->spawn;
	my $head = <$pipi>;
	close $pipi;
	$_[0]->close->wait->ok;
	return $head;
}

my $BASE_URL = $ENV{BASE_URL}; die "please export BASE_URL\n" unless defined $BASE_URL;
my $SITE_URL = $ENV{SITE_URL}; die "please export SITE_URL\n" unless defined $SITE_URL;
my %S = load_state($B);
my $D = $S{config};
my @include = map {
	defined (my $Dv = $D->{$_})
		or die "error: missing \$D->{$_} from MY/config.mk\n";
	$Dv;
} qw( a tem inc );

my ($apath) = grep { -f $_ } map { File::Spec->catfile($_, $file) } @include;
defined $apath or die "template not found: $file\n";
my %I = read_deps($apath);
# location: where the page lives on the site, derived from HAVE
# (e.g. ${a}/site/news/index.html => /news/index.html)
my $location;
if (defined $I{HAVE}) {
	($location = $I{HAVE}) =~ s{^\$\{a\}(?=/)}{}
		or die "$apath: HAVE '$I{HAVE}' is not under \${a}\n";
}
# The configuration (A a B b c), for spelling paths: symbolically, or written
# out as the variables expand (the template gets D, so "${D.B}/${D.b}/x" works).
my %G;	# what each header said, so no file is read twice
my %allowed = map { norm_path($D, $_) => 1 } walk_deps($D, $apath, \%G);
my $built = File::Spec->canonpath("$D->{B}/$D->{b}");

# unused - but when DEFAULT becomes too funky with
# falsy strings, this should do a better job
# example: variable | or_else("default")
sub or_else {
	my ($ctx, $default) = @_;
	return sub {
		my $text = shift;
		return length $text || !(defined $default) ? $text : $default;
	}
}

# to_root(dir): return relative path of how to get to dir
# (defaults to root) example: location | to_root
# tip: there isn't much magic going on with this function.
# if you have a fixed input, you already know its output.
# e.g. '/' | to_root is always going to be './', because...
# well, you are the root.  and '/' | to_root('/share') is
# simply 'share/'.  so avoid using to_root in those simple
# circumstances ^^
sub to_root {
	my ($ctx, $root) = @_;
	$root //= "/";
	unless (substr ($root, 0, 1) eq "/") {
		die "root missing a leading slash: $root\n";
	}
	return sub {
		my $path = shift;
		unless (substr ($path, 0, 1) eq "/") {
			die "URL location missing a leading slash: $path\n";
		}
		my $relative = relapath($root, $path);
		if (substr ($relative, 0, 1) eq "/") {
			die "relapath computed ('$root', '$path') with an "
			. "absolute path ('$relative')\n";
		}
		$relative = '.' unless length $relative;
		$relative .= '/' unless substr($relative, -1) eq '/';
		return $relative;
	}
}

# as_link(is_abs): return full path, relative (0) or absolute (1)
# completely equivalent to joining BASE_URL / SITE_URL, except i am
# seeing if i can avoid passing those variables explicitly now...
# (to get those two, i guess "/" | to_link(0) or (1) works?)
sub as_link {
	my ($ctx, $abs) = @_;
	$abs //= 1;
	return $abs
		? sub { return $SITE_URL . $_[0]; }
		: sub { return $BASE_URL . $_[0]; };
}

sub to_json {
	my ($text) = @_;
	my $h = HTML::Tiny->new (mode => 'html');
	$h->json_encode ($text);
}

# Version the built bytes, and only resources declared by this page (or by
# what it names, as in the head template): ${B}/${b}/x.css or as written out.
sub get_version {
	@_ == 1 or die "get_version requires one resource name\n";
	my ($name) = @_;
	my $path = norm_path($D, $name);
	$built eq '.' || index($path, "$built/") == 0
		or die "get_version: $name is not built (not under \${B}/\${b})\n";
	$allowed{$path}
		or die "get_version: $name is not declared as a NEED or WANT in $apath\n";
	open my $fh, '<:raw', $path or die "open $path: $!\n";
	my $dgst = Digest::SHA->new(1);
	$dgst->addfile($fh);
	close $fh or die "close $path: $!\n";
	my $hash = $dgst->b64digest;
	$hash =~ tr'+/='-_.';
	$hash; # hash! what an impactful statement :)
}

sub changelog {
	use autodie qw(open);
	my $output = '';
	open my $fh, ">", \$output;
	select $fh;

use Poly::Ansi2Html;
use Term::ANSIColor qw( colorstrip );
use Hack::TextWrap; # unconditional name pollution

my $h = HTML::Tiny->new (mode => 'html');
my $htmlify = Poly::Ansi2Html->new(tag => 'strong', no_plain_tag => 1);
# C escapes don't work T_T thanks Jesper...
# https://stackoverflow.com/a/1441062
my $Git_log = $Git->new->set (
	'log', '--color=always',
	'--pretty=format:%h%x09%ai%x09%s%x09%C(auto)%d',
	shift
)->dup(">|", my $revh, "</dev/null")->spawn;
while (<$revh>) {
	chomp; my ($oid, $ai, $s, $d) = split "\t", $_, 4;

	# for some reason, git-diff-tree(1) uses the word
	# "recurse" instead of "recursive" or "recursion"
	# ... which makes searching with less pager a little
	# unsatisfying but oh well :<
	my $Git_diff = $Git->new->set (
		# only consider (A)dded (C)opies (D)eleted (M)odified and (R)enamed
		'diff-tree', '-r', '--diff-filter=ACDMR', $oid . '^1', $oid,
	)->dup(">|", my $diffh, "</dev/null")->spawn;
	my $interesting = 0;
	while (<$diffh>) {
		# sanitization
		chomp; s/^://;
		# split objects & status from the rest first
		my ($obs, $src, $dst) = split /\t/;
		# now split again...
		my ($srcmod, $dstmod, $srcoid, $dstoid, $status) = split / /, $obs;
		next unless $srcmod eq 100644;
		next unless $src =~ /(site|more|temple|include|share)\// ||
			$status =~ /[CR]/ &&
			$dst =~ /(site|more|temple|include|share)\//;
		$interesting = 1; last;
	}
	$Git_diff->close->wait;

	next unless $interesting;
	print for (
		# nobody really needs to see this
		# $h->tag ('span', { class => 'oid' }, $oid),
		# ' ',
		$h->tag ('em', { class => 'date' }, $ai),
		"  ",
		$h->tag ('strong', { class => 'subject' }, $h->entity_encode
			( text_wrap 72, 27, 0, $s )),
		# $htmlify->html ($d),
		"\n",
		# this is a nasty trick to suppress the "undefined ..."
		# warning when there is no diffstat that we can remove
		# once we're done testing and focus on just the
		# interesting commits :)
		pipe_head($Git->new->set('diff', '--shortstat', $oid . '^1', $oid,
			'--', qw( site more template temple include share ))->dup("</dev/null"))
		// ''
			=~ s/([+])/@{[$h->tag ('span', { class => 'add' }, $1)]}/r
			=~ s/([-])/@{[$h->tag ('span', { class => 'del' }, $1)]}/r,
		"\n",
	);
}
$Git_log->close->wait;

	close $fh;
	return $output;
}

my $provider = Site::TemplateProvider->new({
	SOURCE => $file,
	INCLUDE_PATH => \@include,
	D => $D,
	GRAPH => \%G,
}) || die Site::TemplateProvider->error(), "\n";
my $temple = Template->new({
	LOAD_TEMPLATES => [ $provider ],
	EVAL_PERL => 1,
	FILTERS => {
		or_else => [ \&or_else, 1 ],
		to_root => [ \&to_root, 1 ],
		as_link => [ \&as_link, 1 ],
		json => \&to_json,
	},
}) || die $Template::ERROR, "\n";

$temple->process($file, {
	(defined $location ? (location => $location) : ()),
	D => $D,
	get_version => \&get_version,
	changelog => \&changelog,
}) || die $temple->error(), "\n";
