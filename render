#!/usr/bin/env perl

use 5.010;
use strict;
use warnings;
use Template;
use File::Spec;
use File::Spec::Unix;
use Digest::SHA;
# handy guys for templating
use HTML::Tiny;
use Time::Piece;

my $BASE_URL = $ENV{BASE_URL}; die "please export BASE_URL\n" unless defined $BASE_URL;
my $SITE_URL = $ENV{SITE_URL}; die "please export SITE_URL\n" unless defined $SITE_URL;
my @include = qw( site temple include more );

# unused - but when DEFAULT becomes too funky with
# falsy strings, this should do a better job
# example: variable | or_else("default")
sub or_else {
	my ($ctx, $default) = @_;
	return sub {
		my $text = shift;
		return length $text || !(defined $default) ? $text : $default;
	}
}

# to_root(dir): return relative path of how to get to dir
# (defaults to root) example: location | to_root
# tip: there isn't much magic going on with this function.
# if you have a fixed input, you already know its output.
# e.g. '/' | to_root is always going to be '.', because...
# well, you are the root.  and '/' | to_root('/share') is
# simply 'share'.  so avoid using to_root in those simple
# circumstances ^^
sub to_root {
	my ($ctx, $root) = @_;
	$root //= "/";
	unless (substr ($root, 0, 1) eq "/") {
		die "root missing a leading slash: $root\n";
	}
	return sub {
		my $path = shift;
		unless (substr ($path, 0, 1) eq "/") {
			die "URL location missing a leading slash: $path\n";
		}
		my ($volume, $directory, $file) = File::Spec::Unix->splitpath ($path);
		my $relative = File::Spec::Unix->abs2rel ($root, $directory);
		if (substr ($relative, 0, 1) eq "/") {
			die "abs2rel computed ('$root', '$directory') with an "
			. "absolute path ('$relative')\n";
		}
		return $relative . "/";
	}
}

# as_link(is_abs): return full path, relative (0) or absolute (1)
# completely equivalent to joining BASE_URL / SITE_URL, except i am
# seeing if i can avoid passing those variables explicitly now...
# (to get those two, i guess "/" | to_link(0) or (1) works?)
sub as_link {
	my ($ctx, $abs) = @_;
	$abs //= 1;
	return $abs
		? sub { return $SITE_URL . $_[0]; }
		: sub { return $BASE_URL . $_[0]; };
}

sub to_json {
	my ($text) = @_;
	my $h = HTML::Tiny->new (mode => 'html');
	$h->json_encode ($text);
}

# html filter as it was in Template 3.102; 3.103 started turning
# ' into &#39; (cpan-authors/Template2#337), which changes the
# output on us, so pin it retroactively
sub html_filter {
	my $text = shift;
	for ($text) {
		s/&/&amp;/g;
		s/</&lt;/g;
		s/>/&gt;/g;
		s/"/&quot;/g;
	}
	return $text;
}

# versioning trick (i don't care about dates,
# hashing is so much better :)
sub _digest {
	my ($file) = @_;
	my $dgst = Digest::SHA->new(1);
	for my $cat (@include) {
		my $test = File::Spec->catfile ($cat, $file);
		if (-r $test) {
			$file = $test;
			last;
		}
	}
	my $size = -s $file or die "$!: $file";
	$dgst->add("blob $size\0");
	$dgst->addfile($file, 'b');
	$dgst;
}

sub digest {
	my $dgst = _digest (@_);
	my $hash = $dgst->b64digest;
	# PHP seems to have strtr for this.... (whereas
	# in python i recall having str.translate):
	# https://stackoverflow.com/a/5835352
	# in perl we have something better ;)
	$hash =~ tr'+/='-_.';
	$hash; # hash! what an impactful statement :)
}

sub hexdigest {
	my $dgst = _digest (@_);
	$dgst->hexdigest;
}

sub changelog {
	use autodie qw(open);
	my $output = '';
	open my $fh, ">", \$output;
	select $fh;

use Poly::Ansi2Html;
use Term::ANSIColor qw( colorstrip );
use Hack::TextWrap; # unconditional name pollution
use Git;

my $h = HTML::Tiny->new (mode => 'html');
my $htmlify = Poly::Ansi2Html->new(tag => 'strong', no_plain_tag => 1);
# C escapes don't work T_T thanks Jesper...
# https://stackoverflow.com/a/1441062
# (note: the second argument is a impl-defined context
# object, just pass it along and we'll be good)
my ($revh, $revc) = Git::command_output_pipe (
	'log', '--color=always',
	'--pretty=format:%h%x09%ai%x09%s%x09%C(auto)%d',
	shift
);
while (<$revh>) {
	chomp; my ($oid, $ai, $s, $d) = split "\t", $_, 4;

	# for some reason, git-diff-tree(1) uses the word
	# "recurse" instead of "recursive" or "recursion"
	# ... which makes searching with less pager a little
	# unsatisfying but oh well :<
	my ($diffh, $diffc) = Git::command_output_pipe (
		# only consider (A)dded (C)opies (D)eleted (M)odified and (R)enamed
		'diff-tree', '-r', '--diff-filter=ACDMR', $oid . '^1', $oid,
	);
	my $interesting = 0;
	while (<$diffh>) {
		# sanitization
		chomp; s/^://;
		# split objects & status from the rest first
		my ($obs, $src, $dst) = split /\t/;
		# now split again...
		my ($srcmod, $dstmod, $srcoid, $dstoid, $status) = split / /, $obs;
		next unless $srcmod eq 100644;
		next unless $src =~ /(site|more|temple|include|share)\// ||
			$status =~ /[CR]/ &&
			$dst =~ /(site|more|temple|include|share)\//;
		$interesting = 1; last;
	}
	Git::command_close_pipe ($diffh, $diffc);

	next unless $interesting;
	print for (
		# nobody really needs to see this
		# $h->tag ('span', { class => 'oid' }, $oid),
		# ' ',
		$h->tag ('em', { class => 'date' }, $ai),
		"  ",
		$h->tag ('strong', { class => 'subject' }, $h->entity_encode
			( text_wrap 72, 27, 0, $s )),
		# $htmlify->html ($d),
		"\n",
		# this is a nasty trick to suppress the "undefined ..."
		# warning when there is no diffstat that we can remove
		# once we're done testing and focus on just the
		# interesting commits :)
		(Git::command_oneline('diff', '--shortstat', $oid . '^1', $oid,
			'--', qw( site more temple include share )) // '')
			=~ s/([+])/@{[$h->tag ('span', { class => 'add' }, $1)]}/r
			=~ s/([-])/@{[$h->tag ('span', { class => 'del' }, $1)]}/r,
		"\n",
	);
}
Git::command_close_pipe ($revh, $revc);

	close $fh;
	return $output;
}

my $file = shift;
die "usage: $0 <file>\n" unless defined $file;

my $temple = Template->new({
	INCLUDE_PATH => \@include,
	EVAL_PERL => 1,
	FILTERS => {
		or_else => [ \&or_else, 1 ],
		to_root => [ \&to_root, 1 ],
		as_link => [ \&as_link, 1 ],
		json => \&to_json,
		html => \&html_filter,
	},
}) || die $Template::ERROR, "\n";

$temple->process($file, {
	digest => \&digest,
	hexdigest => \&hexdigest,
	changelog => \&changelog,
}) || die $temple->error(), "\n";
