#!/usr/bin/env bash

set -euEo pipefail
source build/common.bash
target="$(realpath -- "$1")"

2>&1 echo "building site version 2025-02-02 at $tmp"
cd "$tmp"
git config --bool advice.detachedHead false
# maintenance branch (patched); the tag still dates the archive
git checkout --detach origin/main/2025-02-02

eval $(perl -Mlocal::lib=local)
myperl="$(command -v perl)"
mycpan="$(command -v cpanm)"
echo "my perl is '$myperl'"
echo "my cpanm is '$mycpan'"
"$mycpan" --installdeps .

# under $tmp so that it gets cleaned up with the rest
bsearch="$tmp/.deps/Algo-BSearch"
fetch_git "$bsearch" "$ALGO_BSEARCH_COMMIT" "${ALGO_BSEARCH_MIRRORS[@]}"

make site PERL5="'$myperl' -Ilib -I'$bsearch/lib'"

package 2025-02-02 public "$target"
