#!/bin/bash

set -euEo pipefail
. build/common
target="$(realpath -- "$1")"

2>&1 echo "building site version 2025-02-02 at $tmp"
cd "$tmp"
git config --bool advice.detachedHead false
git checkout 2025-02-02

eval $(perl -Mlocal::lib=local)
myperl="$(which perl)"
mycpan="$(which cpanm)"
echo "my perl is '$myperl'"
echo "my cpanm is '$mycpan'"
"$mycpan" --installdeps .
"$mycpan" https://ftp.rapidcow.org/pub/lib/perl5/List-BisectSearch/v0.01-rc2.tar.gz

make site PERL5="'$myperl' -Ilib"

package 2025-02-02 public "$target"
