${b}/index.html \
${b}/about.html \
${b}/not_found.html \
${b}/news/index.html \
${b}/news/2024-11-09.html \
${b}/news/2024-11-10.html \
${b}/news/2025-01-03.html \
${b}/news/2025-02-02.html \
${b}/goods/index.html \
${b}/vendor/index.html \
${b}/vendor/oldschool-pc-fonts/index.html \
	: \
# So this is just explicit... unnecessarily so but
	# i think it fits for illustrative purposes.
	# (Actually I have stupid prefixes for this;
	# so this has to be explicit XP never mind.)
		${a}/site/${.TARGET} \
		${A}/render ${A}/optenv
	cd -- ${A:Q} && \
		./optenv ${B:Q} \
			${^X} ${perl5opt} render -B ${B:Q} -b ${b:Q} -- ${a:Q}/${.TARGET:Q} \
			> ${B:Q}/${b:Q}/${.TARGET:Q}

${b}/base.css \
${b}/main.css \
${b}/ansi.css \
${b}/news.css \
${b}/rose-pine.css \
${b}/robots.txt \
	: \
	${a}/more/${.TARGET}
	cd -- ${A:Q} && cp -- ${a:Q}/${.IMPSRC:Q} ${B:Q}/${b:Q}/${.TARGET:Q}

${b}/vendor/oldschool-pc-fonts/Web437_IBM_VGA_8x16.woff \
${b}/vendor/rose-pine/rose-pine-media.css:
	cd -- ${A:Q} && cp -- ${a:Q}/${.IMPSRC:Q} ${B:Q}/${b:Q}/${.TARGET:Q}

# Sass.  ${sass} is deliberately not quoted: it may be `pnpm dlx sass'.
# The stub says what it uses (NEED:), and --load-path lets it find that
# under ${a}.  (Disabling the source map: https://stackoverflow.com/a/27781149)
${b}/vendor/gruvbox/base16.css: ${a}/vendor/gruvbox/base16.scss
	cd -- ${A:Q} && ${sass} --no-source-map --load-path=${a:Q} -- ${.IMPSRC:Q} ${B:Q}/${b:Q}/${.TARGET:Q} </dev/null
